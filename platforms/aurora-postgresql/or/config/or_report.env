# Aurora PostgreSQL Observability Report configuration

# Connection: prefer DATABASE_URL, otherwise set standard PG* variables.
DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=

PSQL_BIN=psql
OUTPUT_DIR=/var/tmp/aurora_or/reports
STATE_DIR=/var/tmp/aurora_or/state
REPORT_TITLE=Aurora PostgreSQL Observability Report
TOP_SQL_LIMIT=150
STATEMENT_TEXT_LENGTH=400
RETENTION_DAYS=14
PGAPPNAME=aurora-or
